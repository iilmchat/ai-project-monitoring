# Сканирование (список корней через запятую)
SCAN_ROOTS=/projects
# Host root подставляется в docker-compose volume (default C:/Projects).
PROJECTS_ROOT=C:/Projects
SCAN_DEPTH=3
SCAN_IGNORE=node_modules,.venv,vendor,dist,build,target
SCAN_CONCURRENCY=4

# Кэш
STATUS_TTL_SECONDS=60
COMPARE_TTL_SECONDS=60
MIRROR_STATUS_TTL_SECONDS=300
MIRROR_POLL_INTERVAL_SECONDS=300

# Провайдеры (токены — только в .env, не в .env.example)
GITHUB_TOKEN=
GITFLIC_TOKEN=
WEBHOOK_SECRET=

# Fetch
FETCH_TIMEOUT=30

# Провайдеры / кэш
PROVIDER_CACHE_TTL_SECONDS=60
DEFAULT_CANONICAL_PROVIDER=github

# Уведомления
NOTIFICATIONS_ENABLED=true
NOTIFY_ON=history_rewritten,missing_on_gitflic,missing_on_github,behind_gitflic
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# БД
DATABASE_URL=sqlite+aiosqlite:///./data/iiruchating.db

# Приложение
DEBUG=false

# Docker (read-only container status)
DOCKER_ENABLED=true
# Пусто = Docker SDK выберет default (npipe на Windows, unix socket на Linux).
DOCKER_HOST=
# Host→container mapping for compose project working_dir / bind-mount sources.
DOCKER_PATH_MAP=C:/Projects=/projects
DOCKER_STATUS_TTL_SECONDS=30
DOCKER_TIMEOUT_SECONDS=3

# Dependency checks (PyPI/npm)
DEPENDENCY_CACHE_TTL_SECONDS=86400
DEPENDENCY_CHECK_CONCURRENCY=4
DEPENDENCY_HTTP_TIMEOUT=5

# Security (OSV.dev CVE + secret scanning)
OSV_API_URL=https://api.osv.dev
SECURITY_CACHE_TTL_SECONDS=21600
SECURITY_CHECK_CONCURRENCY=4
SECURITY_HTTP_TIMEOUT=10
SECRET_SCAN_ENABLED=true
SECRET_SCAN_MAX_FILES=5000
SECRET_SCAN_MAX_FILE_BYTES=1048576
SECRET_SCAN_TTL_SECONDS=300
